{
  "name": "@atc-web/scheduler",
  "version": "1.0.0",
  "private": true,
  "description": "Cron and one-shot job scheduler: signed HTTP calls to your services, retries with backoff, run history, timezone-aware schedules",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alitalipcalikoglu/scheduler.git"
  },
  "type": "module",
  "main": "src/index.js",
  "engines": { "node": ">=22.13" },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning src/index.js",
    "dev": "node --disable-warning=ExperimentalWarning --watch --env-file=.env src/index.js",
    "test": "node --disable-warning=ExperimentalWarning --test \"test/**/*.test.js\"",
    "typecheck": "tsc -p jsconfig.json"
  },
  "dependencies": {
    "@fastify/rate-limit": "11.2.0",
    "fastify": "5.12.4"
  },
  "devDependencies": {
    "@types/node": "22.20.3",
    "typescript": "7.0.2"
  }
}
