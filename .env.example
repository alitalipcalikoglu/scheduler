# --- Server ---
PORT=3008
HOST=0.0.0.0
LOG_LEVEL=info
# Set true only behind a reverse proxy that sets X-Forwarded-For.
TRUST_PROXY=false
# Serve HTTPS directly (PEM files). Leave empty when a reverse proxy terminates TLS.
TLS_CERT_PATH=
TLS_KEY_PATH=
# Request body limit for this API (job definitions), bytes.
BODY_LIMIT=65536

# --- Storage ---
DB_PATH=./data/scheduler.db
# Where the automatic pre-migration snapshot is written. Empty = next to DB_PATH.
DB_BACKUP_DIR=
# Finished runs (succeeded, failed, skipped, cancelled) older than this are deleted. Jobs are kept.
RUN_RETENTION_DAYS=30

# --- Callers: id:secret[:role], comma separated. Secrets >= 32 chars, unique. Generate: openssl rand -hex 32
# Roles: write (manage jobs, trigger and cancel runs), read (list, runs, stats, preview), readwrite (default).
SCHEDULER_API_KEYS=console:REPLACE_WITH_64_HEX_CHARS,deployer:REPLACE_WITH_64_HEX_CHARS:write
# Requests per key per minute.
RATE_LIMIT_MAX=600

# --- Outbound calls ---
# Every call carries X-Scheduler-Signature: t=<unix>,v1=HMAC-SHA256(SIGNING_SECRET, "<t>.<body>"). >= 32 chars.
SIGNING_SECRET=REPLACE_WITH_64_HEX_CHARS
# Bearer tokens jobs may use, by name: a job sets "targetKey": "flags" and the call gets
# Authorization: Bearer <secret>. Secrets stay here; they are never stored in the database or returned by the API.
TARGET_KEYS=flags:REPLACE_WITH_THE_SCHEDULER_KEY_FROM_FLAGS_API_KEYS,notify:REPLACE_WITH_THE_SCHEDULER_KEY_FROM_NOTIFY_API_KEYS
# Plain http:// targets (internal networks). Default false.
TARGET_ALLOW_HTTP=false
# Targets on private, loopback or link-local addresses (your own services). Requires TARGET_ALLOWED_HOSTS.
TARGET_ALLOW_PRIVATE=false
# Host allowlist, comma separated; exact host or parent domain. Empty = any public host.
TARGET_ALLOWED_HOSTS=
# Timezone used when a cron schedule does not name one.
DEFAULT_TIMEZONE=UTC

# --- Worker ---
# Calls executing at the same time.
WORKER_CONCURRENCY=8
# How often due jobs and runs are picked up, milliseconds.
POLL_MS=1000
# Per-call timeout when a job does not set timeoutMs; and the largest a job may ask for.
DEFAULT_TIMEOUT_MS=30000
MAX_TIMEOUT_MS=60000
# Largest retry.max a job may set, and the cap on the exponential backoff.
MAX_RETRIES=10
MAX_BACKOFF_SEC=3600
# Largest JSON-encoded target body.
MAX_BODY_BYTES=16384
# Lease a claimed run holds before another worker may reclaim it as failed, milliseconds.
LEASE_MS=30000
# How often an in-flight call renews its lease. Must be less than LEASE_MS.
HEARTBEAT_MS=10000

# --- Audit (optional): forward write and security events to the audit service. Both or neither. A write-role key: AUDIT_API_KEYS=scheduler:…:write
AUDIT_URL=
AUDIT_API_KEY=
